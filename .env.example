# Copy this file to .env and fill in the values.

# App
VITE_APP_NAME=Nifhry

# Firebase (Project settings > General > Your apps > SDK setup and configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase App Check (reCAPTCHA v3)
VITE_FIREBASE_RECAPTCHA_v3_SITE_KEY=
# Optional: App Check debug token for local development
VITE_FIREBASE_RECAPTCHA_v3_DEBUG_KEY=

# Host of the Firebase emulators in dev mode (Firestore :8080, Auth :9099)
VITE_LOCAL_IP=localhost

# Optional: localStorage key for cached data
VITE_LOCALSTORAGE_DATA_KEY=
